NEXT_PUBLIC_SITE_URL=https://thally.io
NEXT_PUBLIC_THALLY_CLOUD_API_URL=https://app.thally.io

# Optional ownership tokens from Google Search Console and Bing Webmaster Tools.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# /api/unsubscribe (netlify/functions/unsubscribe.ts). Set these in the Netlify
# site's environment, never in a committed file.
# Neon connection string for the Thally Cloud database that holds
# email_preferences. Any of DATABASE_URL, NETLIFY_DATABASE_URL or
# THALLY_CLOUD_DATABASE_URL is also read.
# EMAIL_PREFERENCES_DATABASE_URL=
# Signs the ?token= in every preferences link. When unset, bare addresses are
# accepted (local only). Mint links with scripts/sign-unsubscribe-link.mjs.
# EMAIL_PREFERENCES_SIGNING_SECRET=
# Optional separate salt for the throttling IP digest; defaults to the signing secret.
# EMAIL_PREFERENCES_IP_SALT=
