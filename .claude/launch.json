{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "thally-website",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "thally-website-netlify",
      "runtimeExecutable": "netlify",
      "runtimeArgs": [
        "dev",
        "--offline",
        "--cwd",
        ".",
        "--port",
        "8888",
        "--target-port",
        "3005",
        "--command",
        "pnpm dev --port 3005"
      ],
      "port": 8888
    }
  ]
}
